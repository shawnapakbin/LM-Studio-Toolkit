# Auto detect text files and perform LF normalization
* text=auto

# Enforce LF in the working tree for source/config files so line endings never
# drift on Windows checkouts (core.autocrlf) and Biome's LF formatter stays green.
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.cjs    text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.jsonc  text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.rs     text eol=lf
*.toml   text eol=lf
*.py     text eol=lf
*.sh     text eol=lf

# Windows-native scripts keep CRLF.
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary assets: never touch line endings.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.icns   binary
*.mcpb   binary
*.bundle binary
