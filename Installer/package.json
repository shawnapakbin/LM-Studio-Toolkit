{
  "name": "llm-toolkit-installer",
  "version": "5.4.4",
  "private": true,
  "author": "Shawna Pakbin",
  "description": "Native Windows installer for LLM Toolkit (Tauri v2)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:versions": "tsx scripts/check-version-consistency.ts",
    "generate:runtime-manifest": "tsx scripts/generate-production-manifest.ts",
    "verify:runtime-manifest": "tsx scripts/verify-production-manifest.ts",
    "stage:payload": "tsx scripts/stage-payload.ts",
    "build:installer": "npm run stage:payload && tauri build",
    "dist": "npm run build:installer",
    "test": "jest --config jest.config.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fast-check": "^3.23.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
