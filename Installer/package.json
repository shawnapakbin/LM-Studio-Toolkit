{
  "name": "llm-toolkit-installer",
  "version": "5.1.1",
  "private": true,
  "author": "Shawna Pakbin",
  "description": "Native Windows installer for LLM Toolkit (Tauri v2)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:versions": "tsx scripts/check-version-consistency.ts",
    "stage:payload": "tsx scripts/stage-payload.ts",
    "build:installer": "npm run stage:payload && tauri build",
    "dist": "npm run build:installer",
    "test": "jest --config jest.config.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.8.2",
    "vite": "^6.2.6"
  }
}
