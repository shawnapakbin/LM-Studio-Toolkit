{
  "name": "llm-toolkit-lan-subagent",
  "version": "1.0.0",
  "private": true,
  "description": "LAN-aware multi-endpoint inference dispatcher MCP server for distributed sub-agent task delegation",
  "main": "dist/mcp-server.js",
  "types": "dist/mcp-server.d.ts",
  "type": "commonjs",
  "scripts": {
    "build": "node --max-old-space-size=8192 ../node_modules/typescript/lib/tsc.js -p tsconfig.json && node -e \"const fs=require('fs'),path=require('path');const src=path.join('src','gui','public');const dst=path.join('dist','LanSubAgent','src','gui','public');fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dst,f)));\"",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "lan",
    "subagent",
    "fan-out",
    "parallel",
    "mcp",
    "model-context-protocol",
    "inference",
    "distributed"
  ],
  "author": "Shawna Pakbin",
  "license": "LicenseRef-Shawna-NonCommercial",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@shared/types": "file:../shared",
    "llm-toolkit-observability": "*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "fast-check": "^3.23.2",
    "nock": "^14.0.1",
    "ts-jest": "^29.3.4"
  }
}
