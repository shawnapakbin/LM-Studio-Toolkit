{
  "name": "llm-toolkit-skills",
  "version": "5.4.1",
  "private": true,
  "description": "Skills MCP tool for managing and executing agent skills",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:mcp": "tsx src/mcp-server.ts",
    "build": "tsc -p tsconfig.json && node scripts/postbuild.js && node scripts/seed-skills.js",
    "seed": "node scripts/seed-skills.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/index.js",
    "start:mcp": "node dist/mcp-server.js",
    "test": "jest"
  },
  "dependencies": {
    "@lmstudio/sdk": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@shared/types": "file:../shared",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  }
}
