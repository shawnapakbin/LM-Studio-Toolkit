{
  "name": "@shared/config",
  "version": "5.4.4",
  "description": "Unified configuration system for LLM Toolkit - schema, loader, and migration utilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "default": "./dist/generate.js"
    }
  },
  "bin": {
    "migrate-config": "./dist/migrate-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPattern=tests/unit",
    "test:property": "jest --config jest.config.js --testPathPattern=tests/property",
    "test:integration": "jest --config jest.config.js --testPathPattern=tests/integration",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "fast-check": "^3.23.2",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "config",
    "schema",
    "validation",
    "unified-config"
  ],
  "author": "Shawna Pakbin",
  "license": "LicenseRef-Shawna-NonCommercial"
}
